  const q={sub:'r_pts',topic:'points-liaisons'};
  if(v==='dotted'){const d=pick(lv===1?[12,6]:[12,6,3]),r=d/4,nm=d===24?'ronde pointée':d===3?'croche pointée':figName(d).toLowerCase();
    Object.assign(q,{key:'r_pts:d'+d,prompt:`Dans une mesure à 4/4, combien de temps dure une ${nm} ?`});
    if(fmt==='short')return shortQ(q,fracFr(r),fracAccept(r),{ph:'ex. : 1 ½'});
    return mcQ(q,fracFr(r),[r*2/3,r*4/3,r+1,r-.5,r*2].filter(x=>x!==r&&x>0).map(fracFr));}
  if(v==='count'){const[a,b,nmA,nmB]=pick([[12,4,'blanche pointée','noires'],[6,2,'noire pointée','croches'],[3,1,'croche pointée','doubles-croches']].slice(0,lv===1?2:3));
    Object.assign(q,{key:'r_pts:c'+a,prompt:`Une ${nmA} vaut combien de ${nmB} ?`});
    if(fmt==='short')return shortQ(q,String(a/b),[String(a/b)],{num:true,ph:'un nombre'});
