  if(v==='tie'){const[a,b]=pick([[8,4],[4,2],[8,8],[4,4],[12,4]]),r=(a+b)/4;
    Object.assign(q,{key:`r_pts:t${a}-${b}`,prompt:'Ces deux notes sont reliées par une liaison de prolongation. En 4/4, combien de temps dure le son au total ?',abc:`X:1\nL:1/16\nM:4/4\nK:C\nB${a}-B${b} x${(16-(a+b)%16)%16||''} |]`.replace(' x |]',' |]')});
    if(fmt==='short')return shortQ(q,fracFr(r),fracAccept(r),{ph:'ex. : 3'});
    return mcQ(q,fracFr(r),[a/4,b/4,r+1,r-.5,r*2].filter(x=>x!==r&&x>0).map(fracFr));}
  const beats=pick(lv===3?[3,1.5,.75]:[3,1.5]),u=beats*4;
  Object.assign(q,{key:'r_pts:g'+u,prompt:`En 4/4, quelle figure dure ${fracFr(beats)} temps ?`});
  const cand=[24,16,12,8,6,4,3].filter(x=>x!==u&&x!==24);
  return mcQ(q,{t:'',abc:glyphAbc(u),lab:u===24?'Ronde pointée':figName(u)},qzShuffle(cand).slice(0,5).map(x=>({t:'',abc:glyphAbc(x),lab:figName(x)})));
};
function rhyFill(meter,lv,total,{allowRests=true}={}){
  const m=METERS[meter],bu=m.bu,evs=[];let t=0;
  const pool=m.comp?[[6],[6],[4,2],[2,2,2],[12]]:lv===1?[[4],[4],[2,2],[8]]:[[4],[2,2],[8],[6,2],[1,1,2],[2,1,1],[12],[16]];
  if(allowRests)pool.push(m.comp?[-6]:[-4]);
  while(t<total){const opts=pool.filter(g=>{const s=g.reduce((a,x)=>a+Math.abs(x),0);if(t+s>total)return false;if(s>bu&&t%bu)return false;if(s===12&&!m.comp&&t%(2*bu))return false;return true;});
    const g=opts.length?pick(opts):[[16,12,8,6,4,3,2,1].find(x=>x<=total-t&&(x<=bu||t%bu===0))||1];g.forEach(x=>evs.push({dur:Math.abs(x),rest:x<0}));t+=g.reduce((a,x)=>a+Math.abs(x),0);}
  return evs;
}
QZG.r_lia=(lv,fmts)=>{
  const v=pick(lv===1?['tie','kind']:['tie','kind','bar']);const fmt=qzFmt(v==='kind'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const q={sub:'r_lia',topic:'points-liaisons'};
  if(v==='kind'){const same=Math.random()<.5,n=pick(['B','c','A','G']),m={B:'d',c:'e',A:'c',G:'B'}[n];
    Object.assign(q,{key:'r_lia:k'+same+n,prompt:'Quel type de liaison relie ces deux notes ?',abc:`X:1\nL:1/4\nM:4/4\nK:C\n${same?`${n}2-${n}2`:`(${n}2 ${m}2)`} |]`,small:true});
    return mcQ(q,same?'Liaison de prolongation (même note : le son est tenu)':'Liaison d\'expression (notes différentes : jouées liées)',[same?'Liaison d\'expression (notes différentes : jouées liées)':'Liaison de prolongation (même note : le son est tenu)'],2);}
  if(v==='bar'){const me=pick(['3/4','4/4']),M=METERS[me],tot=M.beats*4;const[a,b]=pick([[4,4],[4,8],[8,4],[4,2]]);const pre=tot-a,post=tot-b,r=(a+b)/4;
    const fill=u=>{const out=[];let x=u;while(x>0){const d=[8,4].find(y=>y<=x)||x;out.push('c'+d);x-=d;}return out.join(' ');};
    Object.assign(q,{key:`r_lia:b${me}${a}${b}`,prompt:`La liaison relie la dernière note de la mesure 1 à la première note de la mesure 2. En ${me}, combien de temps dure ce son au total ?`,abc:`X:1\nL:1/16\nM:${me}\nK:C\n${fill(pre)} B${a}- | B${b} ${fill(post)} |]`});
    if(fmt==='short')return shortQ(q,fracFr(r),fracAccept(r),{ph:'ex. : 2'});
    return mcQ(q,fracFr(r),[a/4,b/4,r+1,r*2].filter(x=>x!==r&&x>0).map(fracFr));}
  const[a,b]=pick([[8,4],[4,2],[8,8],[4,4],[12,4],[4,8]].slice(0,lv===1?4:6)),r=(a+b)/4;
  Object.assign(q,{key:`r_lia:t${a}-${b}`,prompt:'Ces deux notes sont reliées par une liaison de prolongation. En 4/4, combien de temps dure le son au total ?',abc:`X:1\nL:1/16\nM:4/4\nK:C\nB${a}-B${b} x${(16-(a+b)%16)%16||''} |]`.replace(' x |]',' |]')});
  if(fmt==='short')return shortQ(q,fracFr(r),fracAccept(r),{ph:'ex. : 3'});
  return mcQ(q,fracFr(r),[a/4,b/4,r+1,r-.5,r*2].filter(x=>x!==r&&x>0).map(fracFr));
};
QZG.r_mes=(lv,fmts)=>{
  const v=pick(lv===1?['beats','unit','which']:['beats','unit','which','kind']);
  const fmt=qzFmt(v==='which'||v==='kind'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const meters=lv===1?['2/4','3/4','4/4']:['2/4','3/4','4/4','6/8','9/8','12/8'];
  const me=pick(meters),M=METERS[me];const q={sub:'r_mes',topic:M.comp?'mesures-composees':'mesures-simples'};
  if(v==='beats'){Object.assign(q,{key:'r_mes:b'+me,prompt:`Combien de temps y a-t-il dans une mesure à ${me} ?`,abc:`X:1\nL:1/4\nM:${me}\nK:C\nx4 |]`.replace('x4','x'),small:true});
    if(fmt==='short')return shortQ(q,String(M.beats),[String(M.beats)],{num:true,ph:'un nombre'});
    return mcQ(q,String(M.beats),['2','3','4','6','8','12'].filter(x=>x!==String(M.beats)));}
  if(v==='unit'){const ans=M.comp?'Noire pointée':'Noire';Object.assign(q,{key:'r_mes:u'+me,prompt:`Dans une mesure à ${me}, quelle figure vaut un temps ?`});
    if(fmt==='short')return shortQ(q,ans,[ans]);
    return mcQ(q,ans,['Noire','Noire pointée','Croche','Blanche'].filter(x=>x!==ans));}
  if(v==='kind'){const ans=M.comp?'Composée':'Simple';Object.assign(q,{key:'r_mes:k'+me,prompt:`La mesure à ${me} est-elle une mesure simple ou composée ?`});return mcQ(q,ans,[M.comp?'Simple':'Composée'],2);}
  const sm=pick(['2/4','3/4','4/4']),S2=METERS[sm],evs=rhyFill(sm,lv,S2.beats*S2.bu);
  Object.assign(q,{key:'r_mes:w'+sm+evs.map(e=>e.dur).join(''),topic:'mesures-simples',prompt:'Quel chiffre indicateur convient à cette mesure ?',abc:rhyAbc(sm,evs).replace(`M:${sm}`,'M:none')});
  return mcQ(q,sm,['2/4','3/4','4/4'].filter(x=>x!==sm).concat(lv>1?['5/4']:[]));
};
QZG.r_cmp=(lv,fmts)=>{
  const fmt=qzFmt(['staff','mc'],fmts);if(!fmt)return null;
  const me=pick(lv===1?['4/4','3/4','2/4']:lv===2?['4/4','3/4','2/4']:['4/4','3/4','6/8']),M=METERS[me],tot=M.beats*M.bu;
  for(let att=0;att<60;att++){
    const miss=fmt==='mc'?pick(M.comp?[6,12]:lv===1?[4,8]:[4,8,6,12,2]):pick(M.comp?[6,12]:lv===1?[4,8]:[4,8,2,6]);
    if(miss>=tot)continue;const given=rhyFill(me,lv,tot-miss);if(given.reduce((a,e)=>a+e.dur,0)!==tot-miss)continue;
    const q={sub:'r_cmp',topic:'pulsation',key:`r_cmp:${me}:${given.map(e=>(e.rest?'-':'')+e.dur).join('.')}`};
    if(fmt==='mc'){if(![16,12,8,6,4,2].includes(miss))continue;
      Object.assign(q,{prompt:`Quelle figure complète cette mesure à ${me} ?`,abc:rhyAbc(me,given,{spacer:miss})});
      return mcQ(q,{t:'',abc:glyphAbc(miss),lab:figName(miss)},[16,12,8,6,4,2].filter(x=>x!==miss&&x+tot-miss!==tot).map(x=>({t:'',abc:glyphAbc(x),lab:figName(x)})));}
    const fill=[];let r=miss,t=tot-miss;while(r>0){const toBeat=(M.bu-t%M.bu)%M.bu,lim=toBeat?Math.min(toBeat,r):r;const d=[16,12,8,6,4,3,2,1].find(x=>x<=lim);fill.push({dur:d,rest:false});r-=d;t+=d;}
    return Object.assign(q,{fmt:'staff',prompt:`Complète la mesure à ${me} : ajoute des notes ou des silences pour qu'elle contienne exactement ${M.beats} temps.`,
      rhy:{meter:me,given,miss},answerText:`Toute réponse qui ajoute exactement ${fracFr(miss/M.bu)} temps, par exemple : ${fill.map(e=>figName(e.dur).toLowerCase()).join(' + ')}.`,
      answerAbc:rhyAbc(me,[...given,...fill]),paperAbc:rhyAbc(me,given,{spacer:miss}),
      check:r=>Array.isArray(r)&&r.length>0&&r.reduce((a,e)=>a+e.dur,0)===miss,
      respText:r=>Array.isArray(r)&&r.length?r.map(e=>figName(e.dur,e.rest).toLowerCase()||'?').join(' + '):'',respAbc:r=>rhyAbc(me,[...given,...(Array.isArray(r)?r:[])])});
  }
  return null;
};
/* Gammes et tonalités */
const sigText=s=>s===0?'aucune altération':`${Math.abs(s)} ${s>0?'dièse':'bémol'}${Math.abs(s)>1?'s':''}`;
QZG.g_arm=(lv,fmts)=>{
  const v=pick(lv===1?['name','count','pick']:['name','count','pick','both']);
  const fmt=qzFmt(v==='pick'||v==='both'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const pool=qkPool(lv),k=pick(v==='count'?pool.filter(x=>x.sig):pool),clef=lv===1?'treble':pick(['treble','bass']);
  const q={sub:'g_arm',topic:'armures',key:`g_arm:${v}:${k.sig}`};const near=pool.filter(x=>x!==k);
  const armAbc=(kk,cl=clef)=>`X:1\nL:1/4\nK:${keyAbc(kk)} clef=${cl}\nx |]`;
  if(v==='name'){Object.assign(q,{prompt:'Quelle tonalité majeure a cette armure ?',abc:armAbc(k),small:true});
    if(fmt==='short')return shortQ(q,keyFr(k),[...noteAcc(k).map(s=>s+' majeur'),...noteAcc(k),...noteAcc(k).map(s=>s+' maj')],{ph:'ex. : Ré majeur'});
    return mcQ(q,keyFr(k),qzShuffle(near).sort((a,b)=>Math.abs(a.sig-k.sig)-Math.abs(b.sig-k.sig)).slice(0,5).map(x=>keyFr(x)));}
  if(v==='count'){const w=k.sig>0?'dièses':'bémols',n=Math.abs(k.sig);Object.assign(q,{prompt:`Combien de ${w} y a-t-il dans l'armure de ${keyFr(k)} ?`});
    if(fmt==='short')return shortQ(q,String(n),[String(n)],{num:true,ph:'un nombre'});
    return mcQ(q,String(n),[n-1,n+1,n+2,n-2].filter(x=>x>=0&&x<=7).map(String));}
  if(v==='both'){const m=relMinor(k);Object.assign(q,{prompt:'Quelles sont les deux tonalités qui ont cette armure ?',abc:armAbc(k),small:true});
    const lc=x=>x.replace(/^./,ch=>ch.toLowerCase()),lab=kk=>`${keyFr(kk)} et ${lc(keyFr(relMinor(kk),true))}`;
    const wrong=[`${keyFr(k)} et ${lc(keyFr(fromDia(k.L+2,k.alt),true))}`,...qzShuffle(near).slice(0,3).map(lab)];void m;
    return mcQ(q,lab(k),qzShuffle(wrong));}
  Object.assign(q,{prompt:`Laquelle de ces armures est celle de ${keyFr(k)} ?`});
  return mcQ(q,{t:'',abc:armAbc(k),lab:sigText(k.sig),small:true},qzShuffle(near.filter(x=>Math.abs(x.sig)>0||k.sig!==0)).slice(0,5).map(x=>({t:'',abc:armAbc(x),lab:`${sigText(x.sig)}`,small:true})));
};
QZG.g_ord=(lv,fmts)=>{
  const v=pick(['nth','last','order']);const fmt=qzFmt(v==='order'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const q={sub:'g_ord',topic:'armures'};const sharp=Math.random()<.5,ord=sharp?SHARP_ORDER:FLAT_ORDER,a=sharp?1:-1,w=sharp?'dièse':'bémol';
  if(v==='nth'){const i=qzRand(0,lv===1?3:6),n={L:ord[i],alt:a};Object.assign(q,{key:`g_ord:n${w}${i}`,prompt:`Dans l'ordre des ${w}s, quel est le ${ORD[i]} ${w} ?`});
    if(fmt==='short')return shortQ(q,nn(n),[...noteAcc(n),FRN[n.L]],{ph:'ex. : '+(sharp?'do♯':'mi♭')});
    return mcQ(q,nn(n),ord.filter((x,j)=>j!==i).map(L=>nn({L,alt:a})));}
  if(v==='last'){const k=pick(qkPool(lv).filter(x=>sharp?x.sig>0:x.sig<0)),i=Math.abs(k.sig)-1,n={L:ord[i],alt:a};
    Object.assign(q,{key:`g_ord:l${k.sig}`,prompt:`Quel est le dernier ${w} de l'armure de ${keyFr(k)} ?`});
    if(fmt==='short')return shortQ(q,nn(n),[...noteAcc(n),FRN[n.L]],{ph:'ex. : '+(sharp?'sol♯':'la♭')});
    return mcQ(q,nn(n),ord.filter((x,j)=>j!==i).slice(0,6).map(L=>nn({L,alt:a})));}
  const seq=o=>o.map(L=>FRN[L]).join(' – ');const sw=(o,i,j)=>{o=o.slice();[o[i],o[j]]=[o[j],o[i]];return o;};
  Object.assign(q,{key:'g_ord:o'+w,prompt:`Quel est l'ordre des ${w}s dans une armure ?`});
  return mcQ(q,seq(ord),[seq((sharp?FLAT_ORDER:SHARP_ORDER)),seq(sw(ord,1,2)),seq(sw(ord,3,5)),seq(sw(ord,0,1))]);
};
QZG.g_maj=(lv,fmts)=>{
  const v=pick(lv===1?['nth','alts','write1']:['nth','alts','write1','scale']);
  const fmt=v==='write1'||v==='scale'?qzFmt(['staff'],fmts):qzFmt(v==='alts'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const k=pick(v==='alts'?qkPool(lv).filter(x=>x.sig):qkPool(lv)),sc=scaleOf(k),q={sub:'g_maj',topic:'gamme-majeure'};
  if(v==='nth'){const i=qzRand(1,6),n=sc[i];Object.assign(q,{key:`g_maj:n${k.sig}.${i}`,prompt:`Quelle est la ${ORD[i].replace('er','re')} note de la gamme de ${keyFr(k)} ?`});
    if(fmt==='short')return shortQ(q,nn(n),noteAcc(n),{ph:'ex. : fa♯'});
    return mcQ(q,nn(n),[sc[mod7(i+1)],sc[mod7(i-1)],{L:n.L,alt:n.alt?0:(k.sig<0?-1:1)},sc[mod7(i+2)]].map(nn));}
  if(v==='alts'){const lst=ks=>{const ns=scaleOf(ks).filter(x=>x.alt);ns.sort((a,b)=>(ks.sig>0?SHARP_ORDER:FLAT_ORDER).indexOf(a.L)-(ks.sig>0?SHARP_ORDER:FLAT_ORDER).indexOf(b.L));return ns.map(nn).join(', ');};
    Object.assign(q,{key:`g_maj:a${k.sig}`,prompt:`Quelles notes sont altérées dans la gamme de ${keyFr(k)} ?`});
    return mcQ(q,lst(k),QK.filter(x=>x.sig&&x!==k&&Math.sign(x.sig)===Math.sign(k.sig)&&Math.abs(x.sig-k.sig)<=2).map(lst).concat([lst(QK.find(x=>x.sig===-k.sig))]));}
  if(v==='write1'){const i=pick([2,3,4,6]),n=sc[i];const nmD=DEG_NAMES[i].toLowerCase();
    return padQ(Object.assign(q,{key:`g_maj:w${k.sig}.${i}`,prompt:`Écris la ${nmD} (${ORD[i]} degré) de la gamme de ${keyFr(k)} sur la portée (clé de sol).`,topic:'degres'}),
      {clef:'treble',mode:'one',answer:[Object.assign(fromDia(28+n.L+(n.L<3?7:0)),{alt:n.alt})],answerText:nn(n),check:r=>sameNote(r[0],n)});}
  const start=fromDia(28+k.L+(k.L>3?-7:0)+(k.L===0?0:0),k.alt);if(dia(start)<26)start.oct++;
  const ans=Array.from({length:8},(_,i)=>{const d=dia(start)+i,L=mod7(d);return Object.assign(fromDia(d),{alt:scaleOf(k)[mod7(i)].alt});});
  return padQ(Object.assign(q,{key:`g_maj:s${k.sig}`,prompt:`Écris la gamme de ${keyFr(k)} en montant, de la tonique à la tonique (8 notes). Ajoute les altérations devant les notes (pas d'armure).`}),
    {clef:'treble',mode:'seq',max:8,answer:ans,answerText:ans.map(nn).join(' – '),check:r=>r.length===8&&sameNote(r[0],k)&&r.every((n,i)=>i===0||dia(n)===dia(r[i-1])+1)&&r.every((n,i)=>n.alt===sc[i%7].alt)});
};
function minorScale(m,type){ /* m : tonalité mineure (L, alt, sig) */
  const sa=sigAlts(m.sig);const s=Array.from({length:7},(_,d)=>{const L=mod7(m.L+d);return{L,alt:sa[L]};});
  if(type!=='nat')s[6]={L:s[6].L,alt:s[6].alt+1};if(type==='mel')s[5]={L:s[5].L,alt:s[5].alt+1};return s;
}
const MIN_T={nat:'naturelle',har:'harmonique',mel:'mélodique'};
const nnK=(n,sig)=>n.alt===0&&sigAlts(sig)[n.L]!==0?FRN[n.L]+'♮':nn(n);
QZG.g_min=(lv,fmts)=>{
  const v=pick(lv===1?['raised','type']:lv===2?['raised','type','mel']:['raised','type','mel','write']);
  const fmt=v==='write'?qzFmt(['staff'],fmts):qzFmt(v==='type'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const m=relMinor(pick(qkPool(lv).filter(k=>k.sig<=4))),q={sub:'g_min',topic:'gammes-mineures'};const mName=keyFr(m,true);
  if(v==='raised'){const n=minorScale(m,'har')[6],K=x=>nnK(x,m.sig);Object.assign(q,{key:`g_min:r${m.sig}`,prompt:`Dans la gamme de ${mName} harmonique, quelle note est haussée (7e degré, la sensible) ?`});
    if(fmt==='short')return shortQ(q,K(n),[...noteAcc(n),FRN[n.L]+' becarre',FRN[n.L]+'♮'],{ph:'ex. : sol♯'});
    return mcQ(q,K(n),[K(minorScale(m,'nat')[6]),K(minorScale(m,'mel')[5]),K(minorScale(m,'nat')[5]),K({L:mod7(n.L-1),alt:n.alt})].filter(s=>s!==K(n)));}
  if(v==='mel'){const s=minorScale(m,'mel');Object.assign(q,{key:`g_min:m${m.sig}`,prompt:`Dans la gamme de ${mName} mélodique (en montant), quelles notes sont haussées ?`});
    const lab=a=>a.map(x=>nnK(x,m.sig)).join(' et ');
    return mcQ(q,lab([s[5],s[6]]),[lab([s[6]]),lab([s[4],s[6]]),lab([minorScale(m,'nat')[5],s[6]]),lab([s[2],s[6]])]);}
  if(v==='type'){const t=pick(['nat','har','mel']),s=minorScale(m,t);const sa=sigAlts(m.sig);
    const st=fromDia(28+m.L+(m.L>4?-7:0),0);
    const notes=Array.from({length:8},(_,i)=>{const d=dia(st)+i,x=s[i%7];const n=fromDia(d,x.alt);if(x.alt!==sa[n.L]){if(x.alt===0)n.nat=true;return n;}return Object.assign(n,{alt:0,sig:true});});
    const ab=notes.map(n=>n.sig?LET[n.L]+(n.oct>=5?'':''):'').length;void ab;
    const body=notes.map(n=>{if(n.sig){const c=Object.assign({},n,{alt:0,nat:false});return abcN(c,'');}return abcN(n,'');}).join(' ');
    Object.assign(q,{key:`g_min:t${m.sig}${t}`,prompt:`Quel type de gamme mineure est écrit ici (${mName.toLowerCase()}, en montant) ?`,abc:`X:1\nL:1/4\nK:${keyAbc(m)} clef=treble\n${body} |]`});
    return mcQ(q,`Mineure ${MIN_T[t]}`,['nat','har','mel'].filter(x=>x!==t).map(x=>`Mineure ${MIN_T[x]}`),3);}
  const t=pick(['har','mel']),s=minorScale(m,t),st=fromDia(28+m.L+(m.L>4?-7:0));
  const ans=Array.from({length:8},(_,i)=>Object.assign(fromDia(dia(st)+i),{alt:s[i%7].alt}));
  return padQ(Object.assign(q,{key:`g_min:w${m.sig}${t}`,prompt:`Écris la gamme de ${mName} ${MIN_T[t]} en montant, de la tonique à la tonique (8 notes). Ajoute les altérations devant les notes (pas d'armure).`}),
    {clef:'treble',mode:'seq',max:8,answer:ans,answerText:ans.map(nn).join(' – '),check:r=>r.length===8&&sameNote(r[0],m)&&r.every((n,i)=>i===0||dia(n)===dia(r[i-1])+1)&&r.every((n,i)=>n.alt===s[i%7].alt)});
};
QZG.g_rel=(lv,fmts)=>{
  const fmt=qzFmt(['short','mc'],fmts);if(!fmt)return null;
  const k=pick(qkPool(lv)),m=relMinor(k),toMin=Math.random()<.5,q={sub:'g_rel',topic:'relatives',key:`g_rel:${toMin?'m':'M'}${k.sig}`};
  const ans=toMin?m:k,ansT=keyFr(ans,toMin);
  q.prompt=toMin?`Quelle est la tonalité relative mineure de ${keyFr(k)} ?`:`Quelle est la tonalité relative majeure de ${keyFr(m,true)} ?`;
  if(fmt==='short'){const w=toMin?['mineur','min','m']:['majeur','maj'];return shortQ(q,ansT,[...noteAcc(ans),...noteAcc(ans).flatMap(s=>w.map(x=>s+' '+x))],{ph:toMin?'ex. : mi mineur':'ex. : Sol majeur'});}
  const wrong=toMin?[keyFr(fromDia(k.L+2+7,k.alt),true),keyFr({L:k.L,alt:k.alt},true),keyFr(relMinor(QK.find(x=>x.sig===k.sig+1)||QK[1]),true),keyFr(relMinor(QK.find(x=>x.sig===k.sig-1)||QK[8]),true)]
    :[keyFr({L:m.L,alt:m.alt}),keyFr(QK.find(x=>x.sig===k.sig+1)||QK[1]),keyFr(QK.find(x=>x.sig===k.sig-1)||QK[8]),keyFr(fromDia(m.L+4,m.alt))];
  return mcQ(q,ansT,wrong.filter(s=>s!==ansT));
};
QZG.g_deg=(lv,fmts)=>{
  const v=pick(['name','note','which','write']);const fmt=v==='write'?qzFmt(['staff'],fmts):qzFmt(v==='which'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const q={sub:'g_deg',topic:'degres'};
  if(v==='name'){const i=qzRand(lv===1?0:1,6);Object.assign(q,{key:'g_deg:n'+i,prompt:`Comment s'appelle le ${ORD[i]} degré (${ROMANS[i]}) d'une gamme majeure ?`});
    if(fmt==='short')return shortQ(q,DEG_NAMES[i],[DEG_NAMES[i],DEG_NAMES[i].replace('-',' ')],{ph:'ex. : dominante'});
    return mcQ(q,DEG_NAMES[i],DEG_NAMES.filter((x,j)=>j!==i));}
  const k=pick(qkPool(lv)),sc=scaleOf(k),i=pick(lv===1?[4,6]:[1,2,3,4,5,6]),n=sc[i];
  if(v==='note'){Object.assign(q,{key:`g_deg:t${k.sig}.${i}`,prompt:`Quelle est la ${DEG_NAMES[i].toLowerCase()} de ${keyFr(k)} ?`});
    if(fmt==='short')return shortQ(q,nn(n),noteAcc(n),{ph:'ex. : fa♯'});
    return mcQ(q,nn(n),[sc[mod7(i+1)],sc[mod7(i-1)],sc[mod7(i+3)]].map(nn).concat([nn({L:n.L,alt:n.alt?0:1})]));}
  if(v==='which'){Object.assign(q,{key:`g_deg:w${k.sig}.${i}`,prompt:`Dans la gamme de ${keyFr(k)}, la note ${nn(n)} est…`});
    return mcQ(q,`la ${DEG_NAMES[i].toLowerCase()} (${ROMANS[i]})`,DEG_NAMES.map((x,j)=>`la ${x.toLowerCase()} (${ROMANS[j]})`).filter((x,j)=>j!==i));}
  return padQ(Object.assign(q,{key:`g_deg:p${k.sig}.${i}`,prompt:`Écris la ${DEG_NAMES[i].toLowerCase()} de ${keyFr(k)} sur la portée (clé de sol).`}),
    {clef:'treble',mode:'one',answer:[Object.assign(fromDia(28+n.L+(n.L<3?7:0)),{alt:n.alt})],answerText:nn(n),check:r=>sameNote(r[0],n)});
};
QZG.g_cyc=(lv,fmts)=>{
  const fmt=qzFmt(['mc','short'],fmts);if(!fmt)return null;
  const sharp=Math.random()<.5,pool=qkPool(lv).filter(k=>sharp?k.sig>=0&&k.sig<sigMax(lv):k.sig<=0&&k.sig>-sigMax(lv));
  const k=pick(pool),nx=QK.find(x=>x.sig===k.sig+(sharp?1:-1));const q={sub:'g_cyc',topic:'quintes',key:`g_cyc:${k.sig}${sharp}`};
  q.prompt=sharp?`Dans le cycle des quintes, quelle tonalité majeure vient juste après ${keyFr(k)}, dans le sens des dièses (une quinte plus haut) ?`
    :`Dans le cycle des quintes, quelle tonalité majeure vient juste après ${keyFr(k)}, dans le sens des bémols (une quinte plus bas) ?`;
  if(fmt==='short')return shortQ(q,keyFr(nx),[...noteAcc(nx),...noteAcc(nx).map(s=>s+' majeur')],{ph:'ex. : Ré majeur'});
  const prev=QK.find(x=>x.sig===k.sig-(sharp?1:-1));
  return mcQ(q,keyFr(nx),[prev,QK.find(x=>x.sig===k.sig+(sharp?2:-2)),fromDia(k.L+1,k.alt),fromDia(k.L+2,k.alt)].filter(Boolean).map(x=>keyFr(x)));
};
/* Intervalles */
function pickInterval(lv){
  for(let a=0;a<300;a++){
    let root=fromDia(qzRand(28,34));if(lv>1&&Math.random()<.3){const[L,alt]=pick(ROOTS_ACC);root=Object.assign(fromDia(28+L),{alt});}
    let num,q;
    if(lv===3&&Math.random()<.35){num=pick([2,3,4,5,6,7]);q=IV_PERF.has(num)?pick(['augmentée','diminuée']):pick(['augmentée','diminuée']);}
    else{num=qzRand(2,8);q=IV_PERF.has(num)?'juste':pick(['majeure','mineure']);}
    if(lv===2&&Math.random()<.15){num=pick([4,5]);q=num===4?'augmentée':'diminuée';}
    const top=ivAbove(root,num,q);
    if(!okAlts([root,top]))continue;
    if(lv===1&&(root.alt||top.alt))continue;
    if(dia(top)>42)continue;
    return{root,top,iv:ivBetween(root,top)};
  }
  const r=fromDia(28),t=fromDia(32);return{root:r,top:t,iv:ivBetween(r,t)};
}
const IV_FIELDS=lv=>[{label:'Nombre',options:IV_NUM.map((x,i)=>[String(i+1),x.toLowerCase()])},{label:'Qualité',options:QUALS_ALL.map(x=>[x,x])}];
QZG.i_nom=(lv,fmts)=>{
  const fmt=qzFmt(['mc','short'],fmts);if(!fmt)return null;
  const{root,top,iv}=pickInterval(lv),harm=lv>1&&Math.random()<.4,clef=lv===3&&Math.random()<.3?'bass':'treble';
  const shift=clef==='bass'?-2:0,R=Object.assign({},root,{oct:root.oct+shift}),T=Object.assign({},top,{oct:top.oct+shift});
  const q={sub:'i_nom',topic:'intervalles-qualites',key:`i_nom:${noteSlug(root)}${iv.name}`,prompt:'Quel est le nom de cet intervalle (nombre et qualité) ?',
    abc:abcHead(clef)+(harm?`[${abcN(R)}${abcN(T)}]4`:`${abcN(R,'2')} ${abcN(T,'2')}`)+' |]'};
  if(fmt==='short')return fieldsQ(q,IV_FIELDS(lv),[String(iv.num),iv.q],iv.name.toLowerCase().replace(/^./,c=>c.toUpperCase()));
  const alt=[];const qs=IV_PERF.has(iv.num)?['augmentée','diminuée','juste']:['majeure','mineure','augmentée','diminuée'];
  qs.filter(x=>x!==iv.q).forEach(x=>alt.push(IV_NUM[iv.num-1]+' '+x));
  [iv.num-1,iv.num+1].filter(x=>x>=2&&x<=8).forEach(x=>alt.push(IV_NUM[x-1]+' '+(IV_PERF.has(x)?'juste':iv.q==='juste'?'majeure':iv.q)));
  alt.splice(0,alt.length,...alt.filter(qzValidIv));const plain=alt.filter(x=>!/augm|dimin/.test(x));
  return mcQ(q,iv.name,lv<3&&plain.length>=2?plain.concat(lv===2?alt.filter(x=>/augm|dimin/.test(x)).slice(0,1):[]):alt);
};
QZG.i_ecr=(lv,fmts)=>{
  const fmt=qzFmt(['staff'],fmts);if(!fmt)return null;
  for(let a=0;a<100;a++){
    const{root,top,iv}=pickInterval(lv);const down=lv===3&&Math.random()<.4;
    const given=down?top:root,target=down?root:top;
    if(!okAlts([given,target]))continue;
    const q={sub:'i_ecr',topic:'intervalles-qualites',key:`i_ecr:${noteSlug(given)}${iv.name}${down}`};
    return padQ(Object.assign(q,{prompt:`Écris une ${iv.name.toLowerCase()} ${down?'au-dessous':'au-dessus'} de la note donnée.`}),
      {clef:'treble',mode:'one',given:[given],answer:[target],answerText:`${nn(given)} → ${nn(target)}`,
       check:r=>sameNote(r[0],target)&&dia(r[0])===dia(target)});
  }
  return null;
};
QZG.i_dt=(lv,fmts)=>{
  const v=pick(lv===1?['pair','semis']:['pair','semis','write']);const fmt=v==='write'?qzFmt(['staff'],fmts):qzFmt(v==='pair'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const q={sub:'i_dt',topic:'tons-demitons'};
  if(v==='pair'){const L=qzRand(0,6),a={L,alt:0},b={L:mod7(L+1),alt:0};let half=(PC[b.L]-PC[a.L]+12)%12===1;
    if(lv>1&&Math.random()<.4){b.L=a.L;b.alt=1;half=true;}
    Object.assign(q,{key:`i_dt:p${noteSlug(a)}${noteSlug(b)}`,prompt:`Entre ${nn(a)} et ${nn(b)} (en montant), y a-t-il un ton ou un demi-ton ?`});
    return mcQ(q,half?'Un demi-ton':'Un ton',[half?'Un ton':'Un demi-ton'],2);}
  if(v==='semis'){const ivs=[['Seconde mineure',1],['Seconde majeure',2],['Tierce mineure',3],['Tierce majeure',4],['Quarte juste',5],['Quinte juste',7],['Octave juste',12]].concat(lv>1?[['Sixte majeure',9],['Septième mineure',10],['Sixte mineure',8]]:[]);
    const[nm,s]=pick(ivs);Object.assign(q,{key:'i_dt:s'+s,prompt:`Combien de demi-tons y a-t-il dans une ${nm.toLowerCase()} ?`,topic:'intervalles-qualites'});
    if(fmt==='short')return shortQ(q,String(s),[String(s)],{num:true,ph:'un nombre'});
    return mcQ(q,String(s),[s-1,s+1,s+2,s-2].filter(x=>x>0).map(String));}
  const g=fromDia(qzRand(29,35)),tone=Math.random()<.5,semi=tone?2:1;
  return padQ(Object.assign(q,{key:`i_dt:w${noteSlug(g)}${tone}`,prompt:`Écris la note située ${tone?'un ton':'un demi-ton'} au-dessus de la note donnée.`}),
    {clef:'treble',mode:'one',given:[g],answer:[ivAbove(g,2,tone?'majeure':'mineure')],answerText:tone?`${nn(ivAbove(g,2,'majeure'))}`:`${nn(ivAbove(g,2,'mineure'))} (ou ${nn(Object.assign({},g,{alt:g.alt+1}))})`,
     check:r=>noteMidi(r[0])===noteMidi(g)+semi&&(dia(r[0])===dia(g)+1||(!tone&&dia(r[0])===dia(g)))});
};
QZG.i_ren=(lv,fmts)=>{
  const v=pick(lv===1?['sum','inv']:['inv','inv','sum']);const fmt=qzFmt(v==='sum'?['short','mc']:['mc','short'],fmts);if(!fmt)return null;
  const q={sub:'i_ren',topic:'renversement-intervalles'};
  if(v==='sum'){Object.assign(q,{key:'i_ren:sum',prompt:'Un intervalle et son renversement : quand on additionne leurs nombres (ex. : tierce + sixte), quel total obtient-on toujours ?'});
    if(fmt==='short')return shortQ(q,'9',['9'],{num:true,ph:'un nombre'});return mcQ(q,'9',['8','7','10']);}
  const num=qzRand(2,7),qs=IV_PERF.has(num)?(lv===3?['juste','augmentée','diminuée']:['juste']):(lv===3?['majeure','mineure','augmentée','diminuée']:['majeure','mineure']);
  const ql=pick(qs),n2=9-num,inv={juste:'juste',majeure:'mineure',mineure:'majeure',augmentée:'diminuée',diminuée:'augmentée'}[ql];
  const ans=IV_NUM[n2-1]+' '+inv;Object.assign(q,{key:`i_ren:${num}${ql}`,prompt:`Quel est le renversement d'une ${(IV_NUM[num-1]+' '+ql).toLowerCase()} ?`});
  if(fmt==='short')return fieldsQ(q,IV_FIELDS(lv),[String(n2),inv],ans);
  const wrong=[IV_NUM[n2-1]+' '+ql,IV_NUM[num-1]+' '+inv,IV_NUM[(8-num)-1]+' '+inv,...(lv===3?[IV_NUM[n2-1]+' '+(inv==='juste'?'augmentée':inv==='majeure'?'augmentée':'diminuée')]:[])].filter(s=>s!==ans&&qzValidIv(s));
  return mcQ(q,ans,wrong);
};
/* Accords */
function pickTriad(lv,qs){
  for(let a=0;a<300;a++){const ql=pick(qs),root=Object.assign(fromDia(qzRand(28,34)),{alt:lv===1?0:Math.random()<.3?pick([1,-1]):0});
    const t=triad(root,ql);if(okAlts(t))return{root,ql,t};}
  return{root:fromDia(28),ql:'maj',t:triad(fromDia(28),'maj')};
}
const triQs=lv=>lv===1?['maj','min']:lv===2?['maj','min','dim']:['maj','min','dim','aug'];
const chordName=(r,ql)=>`${NN(r)} ${TRI[ql].acc}`;
QZG.a_qua=(lv,fmts)=>{
  const fmt=qzFmt(['mc'],fmts);if(!fmt)return null;
  const{t,ql}=pickTriad(lv,triQs(lv));const q={sub:'a_qua',topic:'triades',key:`a_qua:${noteSlug(t[0])}${ql}`,prompt:'Quelle est la qualité de cette triade ?',abc:abcHead()+`[${t.map(n=>abcN(n)).join('')}]4 |]`};
  return mcQ(q,`Majeure|Mineure|Diminuée|Augmentée`.split('|')[['maj','min','dim','aug'].indexOf(ql)],['Majeure','Mineure','Diminuée','Augmentée'].filter((x,i)=>['maj','min','dim','aug'][i]!==ql));
};
QZG.a_nom=(lv,fmts)=>{
  const fmt=qzFmt(['short','mc'],fmts);if(!fmt)return null;
  const{t,ql,root}=pickTriad(lv,triQs(lv));const q={sub:'a_nom',topic:'triades',key:`a_nom:${noteSlug(root)}${ql}`,prompt:'Nomme cette triade (sa fondamentale et sa qualité).',abc:abcHead()+`[${t.map(n=>abcN(n)).join('')}]4 |]`};
  if(fmt==='short')return fieldsQ(q,[{label:'Fondamentale',options:NOTE_OPTS},{label:'Qualité',options:Object.entries(TRI).filter(([k])=>triQs(3).includes(k)).map(([k,x])=>[k,x.acc])}],[noteSlug(root),ql],chordName(root,ql));
  return mcQ(q,chordName(root,ql),[chordName(root,ql==='maj'?'min':'maj'),chordName(t[1],ql),chordName(t[2],ql==='maj'?'maj':'min'),chordName(fromDia(dia(root)-2,root.alt),ql)]);
};
QZG.a_ecr=(lv,fmts)=>{
  const fmt=qzFmt(['staff'],fmts);if(!fmt)return null;
  const{t,ql,root}=pickTriad(lv,triQs(lv));const set=new Set(t.map(noteSlug));
  return padQ({sub:'a_ecr',topic:'triades',key:`a_ecr:${noteSlug(root)}${ql}`,prompt:`Écris la triade de ${chordName(root,ql).replace(/^./,c=>c)} à l'état fondamental (clé de sol).`},
    {clef:'treble',mode:'chord',max:4,answer:t,answerText:t.map(nn).join(' – '),
     check:r=>{const s=r.slice().sort((a,b)=>dia(a)-dia(b));return s.length===3&&sameNote(s[0],root)&&new Set(s.map(noteSlug)).size===3&&s.every(n=>set.has(noteSlug(n)));}});
};
const MAJ_Q=['maj','min','min','maj','maj','min','dim'],MIN_Q=['min','dim','maj','min','maj','maj','dim'];
const RN_MAJ=['I','ii','iii','IV','V','vi','vii°'],RN_MIN=['i','ii°','III','iv','V','VI','vii°'];
QZG.a_deg=(lv,fmts)=>{
  const v=pick(['chord','roman','qual']);const fmt=qzFmt(v==='chord'?['short','mc']:['mc'],fmts);if(!fmt)return null;
  let k=pick(qkPool(lv===1?1:lv));const minor=lv===3&&Math.random()<.35;if(minor&&k.sig>4)k=QK[4];const key=minor?relMinor(k):k;
  const sc=minor?minorScale(key,'har'):scaleOf(k),QS=minor?MIN_Q:MAJ_Q,RN=minor?RN_MIN:RN_MAJ,i=qzRand(1,6),r=sc[i];
  if(minor&&i===2){r.alt=minorScale(key,'nat')[2].alt;}
  const kName=keyFr(key,minor),q={sub:'a_deg',topic:'accords-degres',key:`a_deg:${v}${key.L}${key.alt}${minor}${i}`};
  if(v==='chord'){Object.assign(q,{prompt:`En ${kName}, quel accord est construit sur le ${ORD[i]} degré (${RN[i]}) ?`+(minor?' (gamme mineure harmonique)':'')});
    if(fmt==='short')return fieldsQ(q,[{label:'Fondamentale',options:NOTE_OPTS},{label:'Qualité',options:Object.entries(TRI).map(([kk,x])=>[kk,x.acc])}],[noteSlug(r),QS[i]],chordName(r,QS[i]));
    return mcQ(q,chordName(r,QS[i]),[chordName(r,QS[i]==='maj'?'min':'maj'),chordName(sc[mod7(i+1)],QS[i]),chordName(sc[mod7(i-1)],QS[mod7(i-1)]==='maj'?'min':'maj')]);}
  if(v==='roman'){Object.assign(q,{prompt:`En ${kName}, quel chiffre romain correspond à l'accord de ${chordName(r,QS[i]).replace(/^./,c=>c.toLowerCase())} ?`});
    return mcQ(q,RN[i],RN.filter((x,j)=>j!==i));}
  Object.assign(q,{prompt:`Dans une tonalité ${minor?'mineure (harmonique)':'majeure'}, quelle est la qualité de l'accord construit sur le ${ORD[i]} degré (${RN[i].replace('°','')}) ?`,key:`a_deg:q${minor}${i}`});
  const cq=TRI[QS[i]].fr.replace(/^./,c=>c.toUpperCase());return mcQ(q,cq,(lv===3?['Majeure','Mineure','Diminuée','Augmentée']:['Majeure','Mineure','Diminuée']).filter(x=>x!==cq),lv===3?4:3);
};
const INV_NAMES=['État fondamental','Premier renversement','Deuxième renversement'];
QZG.a_ren=(lv,fmts)=>{
  const v=pick(lv===1?['name','bass']:['name','bass','fig','write']);const fmt=v==='write'?qzFmt(['staff'],fmts):qzFmt(v==='bass'?['short','mc']:['mc'],fmts);if(!fmt)return null;
  const{t,ql,root}=pickTriad(lv===3?2:1,['maj','min']);const inv=qzRand(0,2);
  const voiced=inv===0?t:inv===1?[t[1],t[2],Object.assign({},t[0],{oct:t[0].oct+1})]:[t[2],Object.assign({},t[0],{oct:t[0].oct+1}),Object.assign({},t[1],{oct:t[1].oct+1})];
  const q={sub:'a_ren',topic:'renversements',key:`a_ren:${v}${noteSlug(root)}${ql}${inv}`};const cn=chordName(root,ql);
  if(v==='name'){Object.assign(q,{prompt:`Cet accord de ${cn.replace(/^./,c=>c.toLowerCase())} est-il à l'état fondamental ou renversé ?`,abc:abcHead()+`[${voiced.map(n=>abcN(n)).join('')}]4 |]`});return mcQ(q,INV_NAMES[inv],INV_NAMES.filter((x,i)=>i!==inv),3);}
  if(v==='fig'){const F=['⁵₃ (état fondamental, sans chiffre)','⁶ (accord de sixte)','⁶₄ (accord de quarte et sixte)'];Object.assign(q,{prompt:'Quel est le chiffrage de cet accord ?',abc:abcHead()+`[${voiced.map(n=>abcN(n)).join('')}]4 |]`});return mcQ(q,F[inv],F.filter((x,i)=>i!==inv),3);}
  if(v==='bass'){const i2=qzRand(1,2),b=t[i2];Object.assign(q,{key:`a_ren:b${noteSlug(root)}${ql}${i2}`,prompt:`Quelle note est à la basse dans le ${i2===1?'premier':'deuxième'} renversement de l'accord de ${cn.replace(/^./,c=>c.toLowerCase())} ?`});
    if(fmt==='short')return shortQ(q,nn(b),noteAcc(b),{ph:'ex. : mi'});return mcQ(q,nn(b),t.filter((x,i)=>i!==i2).map(nn).concat([nn(fromDia(dia(t[0])+1,t[0].alt))]));}
  const i2=qzRand(1,2),set=new Set(t.map(noteSlug)),bass=t[i2];
  const ans=i2===1?[t[1],t[2],Object.assign({},t[0],{oct:t[0].oct+1})]:[t[2],Object.assign({},t[0],{oct:t[0].oct+1}),Object.assign({},t[1],{oct:t[1].oct+1})];
  return padQ(Object.assign(q,{key:`a_ren:w${noteSlug(root)}${ql}${i2}`,prompt:`Écris l'accord de ${cn.replace(/^./,c=>c.toLowerCase())} au ${i2===1?'premier':'deuxième'} renversement (clé de sol).`}),
    {clef:'treble',mode:'chord',max:4,answer:ans,answerText:`${ans.map(nn).join(' – ')} (${nn(bass)} à la basse)`,
     check:r=>{const s=r.slice().sort((a,b)=>dia(a)-dia(b));return s.length===3&&sameNote(s[0],bass)&&new Set(s.map(noteSlug)).size===3&&s.every(n=>set.has(noteSlug(n)));}});
};
QZG.a_v7=(lv,fmts)=>{
  const v=pick(lv===1?['notes','root']:['notes','root','write']);const fmt=v==='write'?qzFmt(['staff'],fmts):qzFmt(v==='notes'?['mc']:['short','mc'],fmts);if(!fmt)return null;
  const k=pick(qkPool(Math.min(lv,2))),sc=scaleOf(k),ch=[4,6,1,3].map(i=>sc[i]);const q={sub:'a_v7',topic:'septiemes',key:`a_v7:${v}${k.sig}`};
  if(v==='root'){Object.assign(q,{prompt:`Sur quelle note est construit l'accord de septième de dominante (V7) de ${keyFr(k)} ?`});
    if(fmt==='short')return shortQ(q,nn(ch[0]),noteAcc(ch[0]),{ph:'ex. : sol'});return mcQ(q,nn(ch[0]),[sc[0],sc[3],sc[6]].map(nn));}
  const lab=a=>a.map(nn).join(' – ');
  if(v==='notes'){Object.assign(q,{prompt:`Quelles notes forment l'accord de septième de dominante (V7) de ${keyFr(k)} ?`});
    return mcQ(q,lab(ch),[lab([ch[0],ch[1],ch[2],{L:ch[3].L,alt:ch[3].alt+1}]),lab([0,2,4,6].map(i=>sc[i])),lab([3,5,0,2].map(i=>sc[i])),lab([ch[0],{L:ch[1].L,alt:ch[1].alt-1},ch[2],ch[3]])].filter(s=>!/𝄪|𝄫/.test(s)));}
  const root=Object.assign(fromDia(28+ch[0].L+(ch[0].L<2?7:0)),{alt:ch[0].alt});const ans=[0,2,4,6].map(s=>Object.assign(fromDia(dia(root)+s),{alt:sc[mod7(4+s)].alt}));const set=new Set(ans.map(noteSlug));
  return padQ(Object.assign(q,{prompt:`Écris l'accord de septième de dominante (V7) de ${keyFr(k)}, à l'état fondamental (clé de sol).`}),
    {clef:'treble',mode:'chord',max:5,answer:ans,answerText:ans.map(nn).join(' – '),check:r=>{const s=r.slice().sort((a,b)=>dia(a)-dia(b));return s.length===4&&sameNote(s[0],ch[0])&&new Set(s.map(noteSlug)).size===4&&s.every(n=>set.has(noteSlug(n)));}});
};
/* Harmonie */
const CADS=[['Parfaite','V – I','les deux accords à l\'état fondamental'],['Imparfaite','V⁶ – I','un des accords est renversé'],['Demi-cadence','IV – V','arrêt sur la dominante'],['Plagale','IV – I',''],['Rompue','V – vi','']];
const CAD_PROG={Parfaite:[['IV',0],['V',0],['I',0]],Imparfaite:[['IV',0],['V',1],['I',0]],'Demi-cadence':[['I',0],['IV',0],['V',0]],Plagale:[['I',0],['IV',0],['I',0]],Rompue:[['IV',0],['V',0],['vi',0]]};
function cadenceEx(name,key){
  let prev=null;const chords=CAD_PROG[name].map(([id,inv])=>{const tones=chordTones(key,id),v=voiceChord(tones,inv,prev,id);if(v.upper)prev=v.upper.map(x=>x.m);return{id,tones,inv,bass:v.bass,upper:v.upper};});
  return chords.some(c=>!c.upper)?null:{kind:'pc',key,chords,n:chords.length,dur:1.4};
}
QZG.h_cad=(lv,fmts)=>{
  const fmt=qzFmt(['mc'],fmts);if(!fmt)return null;
  const pool=lv===1?CADS.filter(c=>c[0]!=='Imparfaite'):CADS;const c=pick(pool);const q={sub:'h_cad',topic:'cadences'};
  const opts=pool.map(x=>x[0]==='Demi-cadence'?'Demi-cadence':'Cadence '+x[0].toLowerCase());const ans=c[0]==='Demi-cadence'?'Demi-cadence':'Cadence '+c[0].toLowerCase();
  if(lv>1&&Math.random()<.5){const key=KEYS[pick(['C','G','F'])];let ex=null;for(let i=0;i<20&&!ex;i++)ex=cadenceEx(c[0],key);
    if(ex){const abc=abcProgression(ex,true).replace(/\nw: .*\n?$/,'\n');Object.assign(q,{key:'h_cad:s'+c[0],prompt:`Quelle cadence termine cette phrase en ${key.fr.toLowerCase().replace(/^./,x=>x.toUpperCase())} ?`,abc});return mcQ(q,ans,opts.filter(x=>x!==ans));}}
  Object.assign(q,{key:'h_cad:'+c[0],prompt:`Quelle cadence correspond à l'enchaînement ${c[1]}${c[2]?' ('+c[2]+')':''} à la fin d'une phrase ?`});
  return mcQ(q,ans,opts.filter(x=>x!==ans));
};
QZG.h_fon=(lv,fmts)=>{
  const fmt=qzFmt(['mc'],fmts);if(!fmt)return null;
  const F={I:'Tonique',IV:'Prédominante (sous-dominante)',ii:'Prédominante (sous-dominante)',V:'Dominante',V7:'Dominante','vii°':'Dominante'};
  const v=pick(['func','which']);const q={sub:'h_fon',topic:'fonctions'};
  if(v==='func'){const c=pick(lv===1?['I','IV','V']:Object.keys(F));Object.assign(q,{key:'h_fon:f'+c,prompt:`Quelle est la fonction tonale de l'accord ${c} ?`});return mcQ(q,F[c],['Tonique','Prédominante (sous-dominante)','Dominante'].filter(x=>x!==F[c]),3);}
  const fn=pick(['Tonique','Prédominante (sous-dominante)','Dominante']),good=Object.keys(F).filter(k=>F[k]===fn),bad=Object.keys(F).filter(k=>F[k]!==fn);
  Object.assign(q,{key:'h_fon:w'+fn,prompt:`Lequel de ces accords a une fonction de ${fn.toLowerCase().replace(' (sous-dominante)','')} ?`});
  return mcQ(q,pick(good),qzShuffle(bad).slice(0,3));
};
/* Termes et signes */
const DYN=[['ppp','pianississimo','extrêmement doux'],['pp','pianissimo','très doux'],['p','piano','doux'],['mp','mezzo piano','moyennement doux'],['mf','mezzo forte','moyennement fort'],['f','forte','fort'],['ff','fortissimo','très fort'],['fff','fortississimo','extrêmement fort']];
QZG.t_nua=(lv,fmts)=>{
  const v=pick(lv===1?['mean','abbr']:['mean','abbr','order','cresc']);const fmt=qzFmt(v==='abbr'?['short','mc']:['mc'],fmts);if(!fmt)return null;
  const pool=lv===1?DYN.slice(1,7):DYN,d=pick(pool),q={sub:'t_nua',topic:'nuances'};
  if(v==='mean'){Object.assign(q,{key:'t_nua:m'+d[0],prompt:`Que signifie la nuance ${d[0]} (${d[1]}) ?`,abc:`X:1\nL:1/4\nK:C\n!${d[0]}!B4 |]`,small:true});return mcQ(q,d[2].replace(/^./,c=>c.toUpperCase()),pool.filter(x=>x!==d).map(x=>x[2].replace(/^./,c=>c.toUpperCase())));}
  if(v==='abbr'){Object.assign(q,{key:'t_nua:a'+d[0],prompt:`Quelle nuance (abréviation) signifie « ${d[2]} » ?`});
    if(fmt==='short')return shortQ(q,`${d[0]} (${d[1]})`,[d[0],d[1]],{ph:'ex. : mp'});return mcQ(q,d[0],pool.filter(x=>x!==d).map(x=>x[0]));}
  if(v==='cresc'){const c=Math.random()<.5;Object.assign(q,{key:'t_nua:c'+c,prompt:'Que signifie ce signe ?',abc:`X:1\nL:1/4\nK:C\n!${c?'crescendo':'diminuendo'}(!B B B !${c?'crescendo':'diminuendo'})!B |]`});
    return mcQ(q,c?'Crescendo : en augmentant le volume':'Decrescendo (diminuendo) : en diminuant le volume',[c?'Decrescendo (diminuendo) : en diminuant le volume':'Crescendo : en augmentant le volume','Accelerando : en accélérant','Legato : notes liées']);}
  const three=qzShuffle(pool).slice(0,3),loud=three.reduce((a,b)=>DYN.indexOf(b)>DYN.indexOf(a)?b:a);const ask=Math.random()<.5;const tgt=ask?loud:three.reduce((a,b)=>DYN.indexOf(b)<DYN.indexOf(a)?b:a);
  Object.assign(q,{key:'t_nua:o'+three.map(x=>x[0]).join(),prompt:`Parmi ces nuances, laquelle est la plus ${ask?'forte':'douce'} ?`});return mcQ(q,tgt[0],three.filter(x=>x!==tgt).map(x=>x[0]),3);
};
const TEMPI=[['Largo','très lent'],['Adagio','lent'],['Andante','allant, au pas'],['Moderato','modéré'],['Allegro','rapide, joyeux'],['Presto','très rapide']];
const TCHG=[['Accelerando','en accélérant',['accelerando','accel']],['Ritardando','en ralentissant',['ritardando','rit','rallentando','rall']],['A tempo','revenir au tempo',['a tempo']]];
QZG.t_tem=(lv,fmts)=>{
  const v=pick(lv===1?['mean','term']:['mean','term','order','change']);const fmt=qzFmt(v==='change'?['short','mc']:['mc'],fmts);if(!fmt)return null;
  const q={sub:'t_tem',topic:'tempo'};const t=pick(TEMPI);
  if(v==='mean'){Object.assign(q,{key:'t_tem:m'+t[0],prompt:`Que signifie l'indication de tempo « ${t[0]} » ?`});return mcQ(q,t[1].replace(/^./,c=>c.toUpperCase()),TEMPI.filter(x=>x!==t).map(x=>x[1].replace(/^./,c=>c.toUpperCase())));}
  if(v==='term'){Object.assign(q,{key:'t_tem:t'+t[0],prompt:`Quel terme italien indique un tempo ${t[1]} ?`});return mcQ(q,t[0],TEMPI.filter(x=>x!==t).map(x=>x[0]));}
  if(v==='order'){const three=qzShuffle(TEMPI).slice(0,3),slow=Math.random()<.5,tg=three.reduce((a,b)=>(TEMPI.indexOf(b)<TEMPI.indexOf(a))===slow?b:a);
    Object.assign(q,{key:'t_tem:o'+three.map(x=>x[0]).join(),prompt:`Parmi ces tempos, lequel est le plus ${slow?'lent':'rapide'} ?`});return mcQ(q,tg[0],three.filter(x=>x!==tg).map(x=>x[0]),3);}
  const c=pick(TCHG);Object.assign(q,{key:'t_tem:c'+c[0],prompt:`Quel terme italien signifie « ${c[1]} » ?`});
  if(fmt==='short')return shortQ(q,c[0]+(c[0]==='Ritardando'?' (ou rallentando)':''),c[2],{ph:'un terme italien'});
  return mcQ(q,c[0],TCHG.filter(x=>x!==c).map(x=>x[0]).concat(['Rubato']));
};
const ARTS=[['Staccato','.B2 .c2 .d2 .e2','Note détachée, courte'],['Tenuto','!tenuto!B2 !tenuto!c2 !tenuto!d2 !tenuto!e2','Note tenue toute sa valeur, légèrement appuyée'],['Accent','!accent!B2 !accent!c2 !accent!d2 !accent!e2','Attaque plus forte'],['Point d\'orgue','B2 c2 d2 !fermata!e2','Tenir plus longtemps, au choix'],['Legato','(B2 c2 d2 e2)','Notes liées, sans interruption']];
QZG.t_art=(lv,fmts)=>{
  const fmt=qzFmt(['mc'],fmts);if(!fmt)return null;
  const pool=lv===1?ARTS.filter(a=>a[0]!=='Tenuto'):ARTS.concat(lv===3?[['Marcato','!marcato!B2 !marcato!c2 !marcato!d2 !marcato!e2','Accent très marqué']]:[]);const a=pick(pool);const v=pick(['name','effect']);
  const q={sub:'t_art',topic:'articulations',key:`t_art:${v}${a[0]}`};
  if(v==='name'){Object.assign(q,{prompt:'Comment s\'appelle le signe d\'articulation écrit sur ces notes ?',abc:`X:1\nL:1/8\nK:C\n${a[1]} |]`});return mcQ(q,a[0],pool.filter(x=>x!==a).map(x=>x[0]));}
  const near=['Accent','Marcato'];Object.assign(q,{prompt:`Quel est l'effet du signe « ${a[0].toLowerCase()} » ?`,abc:`X:1\nL:1/8\nK:C\n${a[1]} |]`});return mcQ(q,a[2],pool.filter(x=>x!==a&&!(near.includes(a[0])&&near.includes(x[0]))).map(x=>x[2]));
};
const REPS=[['D.C. al Fine','Reprendre au début et s\'arrêter au mot Fine'],['D.S.','Retourner au signe 𝄋'],['Barres de reprise (‖: … :‖)','Jouer le passage deux fois'],['Coda','Section de fin du morceau'],['1re et 2e fois','Jouer la case 1, reprendre, puis sauter à la case 2']];
QZG.t_rep=(lv,fmts)=>{
  const fmt=qzFmt(['mc'],fmts);if(!fmt)return null;
  const pool=lv===1?REPS.slice(0,3).concat([REPS[4]]):REPS,r=pick(pool),q={sub:'t_rep',topic:'reprises',key:'t_rep:'+r[0]};
  if(r[0].startsWith('Barres')){Object.assign(q,{prompt:'Que signifient ces barres de mesure ?',abc:'X:1\nL:1/4\nM:4/4\nK:C\n|: c d e f | g2 g2 :|'});return mcQ(q,r[1],pool.filter(x=>x!==r).map(x=>x[1]));}
  if(r[0].startsWith('1re')){Object.assign(q,{prompt:'Comment lit-on ce passage ?',abc:'X:1\nL:1/4\nM:4/4\nK:C\n|: c d e f |[1 g a g2 :|[2 e d c2 |]'});return mcQ(q,r[1],pool.filter(x=>x!==r).map(x=>x[1]));}
  Object.assign(q,{prompt:`Que signifie l'indication « ${r[0]} » ?`});return mcQ(q,r[1],pool.filter(x=>x!==r).map(x=>x[1]));
};
/* Écoute (dans l'app seulement) */
function qzPlayNotes(seq,{gap=.8,dur=.75,chord=false}={}){A.init();stop();const items=chord?[{u:0,d:1,chord:seq}]:seq.map((m,i)=>({u:i,d:1,midi:m}));run({items,us:chord?1.6:gap,endU:chord?1:seq.length});}
QZG.e_int=(lv)=>{
  const sets=lv===1?['3m','3M','4J','5J','8J']:lv===2?['2m','2M','3m','3M','4J','5J','6m','6M','8J']:['2m','2M','3m','3M','4J','tr','5J','6m','6M','7m','7M','8J'];
  const iv=IV_BY[pick(sets)],r=qzRand(55,67),harm=lv===3&&Math.random()<.35,ms=[r,r+iv.s];
  const q={sub:'e_int',topic:'reperes',fmt:'listen',key:`e_int:${iv.id}${harm}`,prompt:`Écoute l'intervalle ${harm?'harmonique (les deux notes ensemble)':'mélodique (en montant)'} et nomme-le.`,play:()=>qzPlayNotes(ms,{chord:harm})};
  return mcQ(q,iv.fr,qzShuffle(sets.filter(x=>x!==iv.id)).map(x=>IV_BY[x].fr));
};
QZG.e_acc=(lv)=>{
  const qs=triQs(lv),ql=pick(qs),r=qzRand(53,65),ms=[r,r+TRI[ql].s[0],r+TRI[ql].s[1]];
  const q={sub:'e_acc',topic:'triades',fmt:'listen',key:'e_acc:'+ql,prompt:'Écoute l\'accord (arpégé puis plaqué). Quelle est sa qualité ?',
    play:()=>{A.init();stop();run({items:[...ms.map((m,i)=>({u:i,d:1,midi:m})),{u:3.4,d:2,chord:ms}],us:.6,endU:5.4});}};
  return mcQ(q,`Accord ${TRI[ql].acc}`,['maj','min','dim','aug'].filter(x=>x!==ql&&(lv>1||x!=='aug')).map(x=>`Accord ${TRI[x].acc}`),lv===1?3:4);
};
QZG.e_mod=(lv)=>{
  const minor=Math.random()<.5,t=minor?pick(lv===1?['har']:['nat','har']):'maj',r=qzRand(57,64);
  const steps=t==='maj'?[0,2,4,5,7,9,11,12]:t==='har'?[0,2,3,5,7,8,11,12]:[0,2,3,5,7,8,10,12];
  const seq=lv===1?steps.concat(steps.slice(0,-1).reverse()).map(s=>r+s):[0,4,2,7,4,2,0].map(i=>r+steps[i]);
  const q={sub:'e_mod',topic:'gammes-mineures',fmt:'listen',key:`e_mod:${t}${lv}`,prompt:lv===1?'Écoute cette gamme. Est-elle majeure ou mineure ?':'Écoute ce court motif. Est-il en mode majeur ou mineur ?',play:()=>{A.init();stop();run({items:seq.map((m,i)=>({u:i,d:1,midi:m})),us:lv===1?.32:.45,endU:seq.length});}};
  const W=lv===1?['Majeure','Mineure']:['Majeur','Mineur'];return mcQ(q,minor?W[1]:W[0],[minor?W[0]:W[1]],2);
};
QZG.e_cad=(lv)=>{
  const names=lv===1?['Parfaite','Demi-cadence']:['Parfaite','Demi-cadence','Plagale','Rompue'];const c=pick(names);
  let ex=null;for(let i=0;i<20&&!ex;i++)ex=cadenceEx(c,KEYS.C);
  const lab=x=>x==='Demi-cadence'?'Demi-cadence':'Cadence '+x.toLowerCase();
  const q={sub:'e_cad',topic:'cadences',fmt:'listen',key:'e_cad:'+c,prompt:'Écoute la fin de la phrase. Quelle cadence entends-tu ?',
    play:()=>{if(!ex)return;A.init();stop();run({items:ex.chords.map((ch,i)=>({u:i,d:1,chord:[ch.bass.m,...ch.upper.map(x=>x.m)]})),us:1.3,endU:ex.chords.length});}};
  return mcQ(q,lab(c),names.filter(x=>x!==c).map(lab));
};
QZG.e_rhy=(lv)=>{
  const me=lv===3?pick(['4/4','3/4','6/8']):pick(['4/4','3/4']),M=METERS[me],tot=M.beats*M.bu;const seen=new Set(),opts=[];
  for(let i=0;i<40&&opts.length<3;i++){const e=rhyFill(me,lv,tot,{allowRests:lv>1});const k=e.map(x=>(x.rest?'-':'')+x.dur).join('.');if(seen.has(k))continue;seen.add(k);opts.push(e);}
  const good=opts[0];
  const q={sub:'e_rhy',topic:'figures-notes',fmt:'listen',key:'e_rhy:'+[...seen][0],prompt:'Écoute le rythme (après une mesure de décompte). Lequel as-tu entendu ?',
    play:()=>{A.init();stop();const items=[];let u=tot;good.forEach(e=>{items.push({u,d:e.dur,rest:e.rest});u+=e.dur;});
      const clicks=Array.from({length:M.beats},(_,k)=>({u:k*M.bu,strong:k===0,b:k}));run({items,clicks,us:60/(M.comp?56:80)/M.bu,endU:u},{sound:'wood'});}};
  return mcQ(q,{t:'',abc:rhyAbc(me,good),lab:'le rythme entendu'},opts.slice(1).map(e=>({t:'',abc:rhyAbc(me,e),lab:'autre rythme'})),3);
};

/* ---------- tirage d'un questionnaire ---------- */
function qzRng(seed){let a=seed>>>0;return()=>{a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function qzBuild(cfg,seed,{paper=false}={}){
  const orig=Math.random;Math.random=qzRng(seed);
  try{
    const subs=cfg.topics.filter(s=>QZ_SUB[s]&&QZG[s]&&!(paper&&QZ_SUB[s].subj.listen));
    if(!subs.length)return[];
    const qs=[],keys=new Set();let tries=0,order=qzShuffle(subs),k=0;
    while(qs.length<cfg.n&&tries<cfg.n*40){
      tries++;const s=order[k%order.length];k++;if(k%order.length===0)order=qzShuffle(subs);
      let q=null;try{q=QZG[s](cfg.level,cfg.formats);}catch(e){console.warn('quiz',s,e);q=null;}
      if(!q)continue;if(q.key&&keys.has(q.key))continue;if(q.key)keys.add(q.key);
      q.subj=QZ_SUB[s].subj.id;qs.push(q);
    }
    /* regroupe par sujet, dans l'ordre des onglets */
    const so=QZ_SUBJ.map(x=>x.id);qs.sort((a,b)=>so.indexOf(a.subj)-so.indexOf(b.subj));
    return qs;
  }finally{Math.random=orig;}
}
