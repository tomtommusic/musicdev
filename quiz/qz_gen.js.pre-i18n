  const r=d/4;Object.assign(q,{key:'r_sil:b'+d,prompt:`Dans une mesure à 4/4, combien de temps dure un silence appelé « ${figName(d,true).toLowerCase()} » ?`});
  if(fmt==='short')return shortQ(q,fracFr(r),fracAccept(r),{ph:'ex. : 1'});
