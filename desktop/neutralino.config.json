{
  "applicationId": "ca.tomtommusic.musidev",
  "version": "1.5.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": [],
  "modes": {
    "window": {
      "title": "MusiDev",
      "width": 1200,
      "height": 820,
      "minWidth": 380,
      "minHeight": 560,
      "center": true,
      "icon": "/resources/icons/icon-512.png",
      "enableInspector": false,
      "resizable": true
    }
  },
  "cli": {
    "binaryName": "MusiDev",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "frontendLibrary": { "patchFile": "/resources/index.html", "devUrl": "" }
  }
}
